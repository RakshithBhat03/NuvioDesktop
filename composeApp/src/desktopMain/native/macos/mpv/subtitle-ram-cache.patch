+// Only single-file containers: selecting unused HLS/DASH tracks could open
+// additional network resources. Standalone external tracks are excluded.
+static bool track_cache_enabled(struct demux_internal *in, enum stream_type type)
+{
+    int64_t limit = type == STREAM_SUB ? in->d_user->opts->subtitle_cache_bytes
+                                      : in->d_user->opts->audio_cache_bytes;
+    if (!limit || in->back_demuxing ||
+        (type != STREAM_SUB && type != STREAM_AUDIO))
+        return false;
+    const char *filetype = in->d_thread->filetype;
+    bool container = in->d_thread->desc == &demuxer_desc_matroska ||
+        (filetype && (!strcmp(filetype, "matroska,webm") ||
+                      !strcmp(filetype, "mov,mp4,m4a,3gp,3g2,mj2") ||
+                      !strcmp(filetype, "avi")));
+    if (!container)
+        return false;
+    int matching = 0;
+    bool has_other_type = false;
+    for (int n = 0; n < in->num_streams; n++) {
+        matching += in->streams[n]->type == type;
+        has_other_type |= in->streams[n]->type != type;
+    }
+    return matching > 1 || (type == STREAM_SUB && has_other_type);
+}
+
+static struct track_switch_cache *track_cache(struct demux_internal *in,
+                                              enum stream_type type)
+{
+    return type == STREAM_AUDIO ? &in->audio_cache : &in->subtitle_cache;
+}
+
+static size_t track_cache_limit(struct demux_internal *in, enum stream_type type)
+{
+    return type == STREAM_AUDIO ? in->d_user->opts->audio_cache_bytes
+                                : in->d_user->opts->subtitle_cache_bytes;
+}
+
+static void track_cache_pop(struct track_switch_cache *cache)
+{
+    struct track_cache_entry *entry = cache->head;
+    cache->head = entry->next;
+    cache->bytes -= entry->bytes;
+    if (!cache->head)
+        cache->tail = NULL;
+    talloc_free(entry);
+}
+
+static void track_cache_clear(struct track_switch_cache *cache)
+{
+    while (cache->head)
+        track_cache_pop(cache);
+}
+
+static void track_cache_store(struct demux_internal *in, struct demux_packet *dp,
+                              enum stream_type type)
+{
+    if (in->track_cache_replaying || in->seeking ||
+        !track_cache_enabled(in, type))
+        return;
+    struct track_switch_cache *cache = track_cache(in, type);
+    size_t limit = track_cache_limit(in, type);
+    // Include packet metadata, side data and an allowance for entry allocation.
+    size_t bytes = demux_packet_estimate_total_size(dp) +
+                   sizeof(struct track_cache_entry) + 128;
+    // A short packet may reference a much larger shared backing allocation.
+    // Charge the full buffer, conservatively even when other entries share it.
+    if (dp->avpacket && dp->avpacket->buf && dp->avpacket->buf->size > dp->len)
+        bytes += dp->avpacket->buf->size - dp->len;
+    if (bytes > limit)
+        return; // Never retain an oversized packet or reread it from the source.
+    double cutoff = MP_NOPTS_VALUE;
+    for (int n = 0; n < in->num_streams; n++) {
+        struct demux_stream *ds = in->streams[n]->ds;
+        if (ds->selected && ds->type != STREAM_SUB)
+            cutoff = MP_PTS_MIN(cutoff, ds->base_ts);
+    }
+    cutoff = MP_ADD_PTS(cutoff, -120);
+    while (cache->head) {
+        struct demux_packet *old = cache->head->packet;
+        double end = MP_ADD_PTS(old->pts, MPMAX(old->duration, 0));
+        if (cache->bytes + bytes <= limit &&
+            !(cutoff != MP_NOPTS_VALUE && end != MP_NOPTS_VALUE && end < cutoff))
+            break;
+        track_cache_pop(cache);
+    }
+    struct demux_packet *copy = demux_copy_packet(dp);
+    if (!copy)
+        return;
+    struct track_cache_entry *entry = talloc_zero(in, struct track_cache_entry);
+    entry->packet = talloc_steal(entry, copy);
+    entry->bytes = bytes;
+    if (cache->tail)
+        cache->tail->next = entry;
+    else
+        cache->head = entry;
+    cache->tail = entry;
+    cache->bytes += bytes;
+    assert(cache->bytes <= limit);
+}
