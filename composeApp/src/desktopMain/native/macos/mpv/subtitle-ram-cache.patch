+// Restore only the subtitle queue. No A/V queue mutation and no source seek,
+// even on a cache miss. The next available subtitle packet will be displayed.
+static void subtitle_cache_replay(struct demux_internal *in,
+                                  struct demux_stream *ds, double ref_pts)
+{
+    bool eof = in->eof;
+    bool after_seek = in->after_seek;
+    bool after_seek_to_start = in->after_seek_to_start;
+    double demux_ts = in->demux_ts;
+    ds_clear_reader_queue_state(ds);
+    clear_queue(ds->queue);
+    in->subtitle_replaying = true;
+    for (struct subtitle_cache_entry *e = in->subtitle_head; e; e = e->next) {
+        struct demux_packet *p = e->packet;
+        if (p->stream != ds->index)
+            continue;
+        double end = MP_ADD_PTS(p->pts, MPMAX(p->duration, 0));
+        if (ref_pts != MP_NOPTS_VALUE && end != MP_NOPTS_VALUE && end < ref_pts)
+            continue;
+        struct demux_packet *copy = demux_copy_packet(p);
+        if (copy)
+            add_packet_locked(ds->sh, copy);
+    }
+    in->subtitle_replaying = false;
+    in->demux_ts = demux_ts;
+    in->after_seek = after_seek;
+    in->after_seek_to_start = after_seek_to_start;
+    in->eof = eof;
+    ds->eof = eof;
+    wakeup_ds(ds);
+    MP_VERBOSE(in, "subtitle RAM switch track=%d retained=%zu bytes\n",
+               ds->index, in->subtitle_bytes);
+}
