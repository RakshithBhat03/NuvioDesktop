+// Only single-file containers: selecting unused HLS/DASH tracks could open
+// additional network resources. External subtitle demuxers have no A/V tracks.
+static bool subtitle_cache_enabled(struct demux_internal *in)
+{
+    if (!in->d_user->opts->subtitle_cache_bytes || in->back_demuxing)
+        return false;
+    const char *type = in->d_thread->filetype;
+    bool container = in->d_thread->desc == &demuxer_desc_matroska ||
+        (type && (!strcmp(type, "matroska,webm") ||
+                  !strcmp(type, "mov,mp4,m4a,3gp,3g2,mj2") ||
+                  !strcmp(type, "avi")));
+    if (!container)
+        return false;
+    for (int n = 0; n < in->num_streams; n++) {
+        if (in->streams[n]->type != STREAM_SUB)
+            return true;
+    }
+    return false;
+}
+
+static void subtitle_cache_pop(struct demux_internal *in)
+{
+    struct subtitle_cache_entry *entry = in->subtitle_head;
+    in->subtitle_head = entry->next;
+    in->subtitle_bytes -= entry->bytes;
+    if (!in->subtitle_head)
+        in->subtitle_tail = NULL;
+    talloc_free(entry);
+}
+
+static void subtitle_cache_clear(struct demux_internal *in)
+{
+    while (in->subtitle_head)
+        subtitle_cache_pop(in);
+}
+
+static void subtitle_cache_store(struct demux_internal *in, struct demux_packet *dp)
+{
+    if (in->subtitle_replaying || in->seeking || !subtitle_cache_enabled(in))
+        return;
+    size_t limit = in->d_user->opts->subtitle_cache_bytes;
+    // Include packet metadata, side data and an allowance for entry allocation.
+    size_t bytes = demux_packet_estimate_total_size(dp) +
+                   sizeof(struct subtitle_cache_entry) + 128;
+    // A short packet may reference a much larger shared backing allocation.
+    // Charge the full buffer, conservatively even when other entries share it.
+    if (dp->avpacket && dp->avpacket->buf && dp->avpacket->buf->size > dp->len)
+        bytes += dp->avpacket->buf->size - dp->len;
+    if (bytes > limit)
+        return; // Never retain an oversized packet or reread it from the source.
+    double cutoff = MP_NOPTS_VALUE;
+    for (int n = 0; n < in->num_streams; n++) {
+        struct demux_stream *ds = in->streams[n]->ds;
+        if (ds->selected && ds->type != STREAM_SUB)
+            cutoff = MP_PTS_MIN(cutoff, ds->base_ts);
+    }
+    cutoff = MP_ADD_PTS(cutoff, -120);
+    while (in->subtitle_head) {
+        struct demux_packet *old = in->subtitle_head->packet;
+        double end = MP_ADD_PTS(old->pts, MPMAX(old->duration, 0));
+        if (in->subtitle_bytes + bytes <= limit &&
+            !(cutoff != MP_NOPTS_VALUE && end != MP_NOPTS_VALUE && end < cutoff))
+            break;
+        subtitle_cache_pop(in);
+    }
+    struct demux_packet *copy = demux_copy_packet(dp);
+    if (!copy)
+        return;
+    struct subtitle_cache_entry *entry = talloc_zero(in, struct subtitle_cache_entry);
+    entry->packet = talloc_steal(entry, copy);
+    entry->bytes = bytes;
+    if (in->subtitle_tail)
+        in->subtitle_tail->next = entry;
+    else
+        in->subtitle_head = entry;
+    in->subtitle_tail = entry;
+    in->subtitle_bytes += bytes;
+    assert(in->subtitle_bytes <= limit);
+}
