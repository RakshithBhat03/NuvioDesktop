+// Restore only the newly selected track queue without mutating video or seeking
+// the source. Audio falls back to the normal refresh seek on a cache miss.
+static bool track_cache_replay(struct demux_internal *in,
+                               struct demux_stream *ds, double ref_pts)
+{
+    struct track_switch_cache *cache = track_cache(in, ds->type);
+    double replay_pts = ds->type == STREAM_AUDIO
+                      ? MP_ADD_PTS(ref_pts, -1.0) : ref_pts;
+    bool has_audio_before = ref_pts == MP_NOPTS_VALUE;
+    bool has_audio_after = ref_pts == MP_NOPTS_VALUE;
+    for (struct track_cache_entry *e = cache->head; e; e = e->next) {
+        struct demux_packet *p = e->packet;
+        if (p->stream != ds->index)
+            continue;
+        double end = MP_ADD_PTS(p->pts, MPMAX(p->duration, 0));
+        has_audio_before |= p->pts != MP_NOPTS_VALUE && p->pts <= ref_pts;
+        has_audio_after |= end != MP_NOPTS_VALUE && end >= ref_pts;
+    }
+    if (ds->type == STREAM_AUDIO && (!has_audio_before || !has_audio_after))
+        return false;
+
+    bool eof = in->eof;
+    bool after_seek = in->after_seek;
+    bool after_seek_to_start = in->after_seek_to_start;
+    double demux_ts = in->demux_ts;
+    ds_clear_reader_queue_state(ds);
+    clear_queue(ds->queue);
+    in->track_cache_replaying = true;
+    for (struct track_cache_entry *e = cache->head; e; e = e->next) {
+        struct demux_packet *p = e->packet;
+        if (p->stream != ds->index)
+            continue;
+        double end = MP_ADD_PTS(p->pts, MPMAX(p->duration, 0));
+        if (replay_pts != MP_NOPTS_VALUE && end != MP_NOPTS_VALUE &&
+            end < replay_pts)
+            continue;
+        struct demux_packet *copy = demux_copy_packet(p);
+        if (copy)
+            add_packet_locked(ds->sh, copy);
+    }
+    in->track_cache_replaying = false;
+    in->demux_ts = demux_ts;
+    in->after_seek = after_seek;
+    in->after_seek_to_start = after_seek_to_start;
+    in->eof = eof;
+    ds->eof = eof;
+    wakeup_ds(ds);
+    MP_VERBOSE(in, "%s RAM switch track=%d retained=%zu bytes\n",
+               ds->type == STREAM_AUDIO ? "audio" : "subtitle",
+               ds->index, cache->bytes);
+    return true;
+}
